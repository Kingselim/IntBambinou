{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bambinou": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/bambinou",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"

            ],
            "styles": [
              "src/styles.css",
              "src/assets/css/bootstrap.min.css",
              "src/assets/css/style.css",
              "src/assets/lib/animate/animate.min.css",
              "src/assets/lib/lightbox/css/lightbox.min.css",
              "src/assets/lib/owlcarousel/assets/owl.carousel.min.css",

             
            

            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "../bambinou/node_modules/jsvectormap/dist/jsvectormap.js",
              "../bambinou/node_modules/jsvectormap/dist/jsvectormap.min.js",
              "src/assets/lib/wow/wow.min.js",
              "src/assets/lib/easing/easing.min.js",
              "src/assets/lib/waypoints/waypoints.min.js",
              "src/assets/lib/lightbox/js/lightbox.min.js",
              "src/assets/lib/owlcarousel/owl.carousel.min.js",
              "src/assets/js/main.js",
              "src/assets/BackOffice/assets/js/core/bootstrap.min.js",
              "src/assets/BackOffice/assets/js/core/jquery-3.7.1.min.js",
              "src/assets/BackOffice/assets/js/core/popper.min.js",
              "src/assets/BackOffice/assets/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js",
              "src/assets/BackOffice/assets/js/plugin/chart.js/chart.min.js",
              "src/assets/BackOffice/assets/js/plugin/jquery.sparkline/jquery.sparkline.min.js",
              "src/assets/BackOffice/assets/js/plugin/chart-circle/circles.min.js",
              "src/assets/BackOffice/assets/js/plugin/datatables/datatables.min.js",
              "src/assets/BackOffice/assets/js/plugin/bootstrap-notify/bootstrap-notify.min.js",
              "src/assets/BackOffice/assets/js/plugin/jsvectormap/jsvectormap.min.js",
              "src/assets/BackOffice/assets/js/plugin/jsvectormap/world.js",
              "src/assets/BackOffice/assets/js/plugin/gmaps/gmaps.js",
              "src/assets/BackOffice/assets/js/setting-demo.js",
              "src/assets/BackOffice/assets/js/setting-demo2.js",
              "src/assets/BackOffice/assets/js/plugin/jsvectormap/world.js"
             
              
              
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "bambinou:build:production"
            },
            "development": {
              "browserTarget": "bambinou:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "bambinou:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
